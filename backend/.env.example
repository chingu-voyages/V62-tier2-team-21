OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
# Maximum LLM generations allowed per IP address each UTC day.
DAILY_GENERATION_LIMIT=3

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated list of frontend origins allowed to call this API.
# Include the deployed Vercel frontend URL; replace it if the team adopts a custom domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://frontend-eight-delta-rtq9f8yit6.vercel.app

# PostgreSQL for user accounts: Supabase Transaction Pooler (port 6543), sslmode=require.
# Replace the placeholders; URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Login sessions last 15 days. Failed logins lock an account after five attempts for 15 minutes.
# Sessions use database-backed random bearer tokens and require no signing secret.

# Test-only database used by backend/tests. Tests refuse to run if it equals DATABASE_URL.
# Never point it at production: the tests truncate the users table.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/lpg_test
